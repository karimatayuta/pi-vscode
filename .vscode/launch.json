{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Pi Agent",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}"],
			"outFiles": ["${workspaceFolder}/dist/**/*.js"],
			"preLaunchTask": "bun: build",
			"sourceMaps": true,
			"env": {
				"NODE_OPTIONS": "--enable-source-maps"
			}
		}
	]
}
